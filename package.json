{
  "name": "videosave-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && source venv/bin/activate && uvicorn app.main:app --reload",
    "install:all": "npm install && cd backend && pip install -r requirements.txt",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.4",
    "typescript": "~5.9.2"
  },
  "workspaces": [
    "frontend",
    "lib/*"
  ]
}
